{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HM_CRYPTO_V1 local contract",
  "type": "object",
  "$defs": {
    "TradeIntent": {
      "type": "object",
      "required": [
        "contract_version",
        "signal_id",
        "snapshot_id",
        "created_at_utc",
        "exchange",
        "environment",
        "market_mode",
        "symbol",
        "pattern_type",
        "direction",
        "order_intent",
        "decision",
        "thesis_id",
        "attempt_no",
        "final_confidence",
        "entry_plan",
        "invalidation",
        "targets",
        "risk_reward",
        "ttl_ms",
        "config_version",
        "strategy_version",
        "integrity_hash"
      ],
      "properties": {
        "contract_version": {
          "const": "HM_CRYPTO_V1"
        },
        "signal_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at_utc": {
          "type": "string"
        },
        "exchange": {
          "enum": [
            "BYBIT",
            "BINANCE"
          ]
        },
        "environment": {
          "enum": [
            "DEMO",
            "REAL"
          ]
        },
        "market_mode": {
          "enum": [
            "SPOT",
            "DERIVATIVES"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "pattern_type": {
          "enum": [
            "PRE_BREAKOUT",
            "BREAKOUT",
            "CONTINUATION",
            "REVERSAL"
          ]
        },
        "direction": {
          "enum": [
            "LONG",
            "SHORT",
            "NONE"
          ]
        },
        "order_intent": {
          "enum": [
            "OPEN",
            "CLOSE",
            "REDUCE",
            "NONE"
          ]
        },
        "decision": {
          "enum": [
            "NO_TRADE",
            "WATCH",
            "ARMED",
            "ENTER"
          ]
        },
        "thesis_id": {
          "type": "string"
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 0
        },
        "final_confidence": {
          "type": [
            "number",
            "string"
          ]
        },
        "entry_plan": {
          "type": "object"
        },
        "invalidation": {
          "type": "object"
        },
        "targets": {
          "type": "array"
        },
        "risk_reward": {},
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "config_version": {
          "type": "string"
        },
        "strategy_version": {
          "type": "string"
        },
        "integrity_hash": {
          "type": "string",
          "minLength": 64
        }
      }
    },
    "ExecutionReport": {
      "type": "object",
      "required": [
        "contract_version",
        "execution_id",
        "signal_id",
        "created_at_utc",
        "exchange",
        "environment",
        "market_mode",
        "symbol",
        "approved",
        "reason_codes",
        "final_qty",
        "final_notional",
        "leverage",
        "margin_mode",
        "order_ids",
        "order_link_ids",
        "order_state",
        "fill_state",
        "avg_fill_price",
        "fees",
        "realized_pnl",
        "stop_state",
        "take_profit_state",
        "risk_snapshot_before",
        "risk_snapshot_after",
        "daily_loss_lock",
        "max_loss_lock",
        "reconciled",
        "integrity_hash"
      ]
    }
  }
}
