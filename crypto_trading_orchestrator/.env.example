# =========================================================
# ORCHESTRATOR
# =========================================================
ORCHESTRATOR_VERSION=HM_ORCHESTRATOR_V1
CONTRACT_VERSION=HM_CRYPTO_V1
RUNTIME_MODE=LIVE
EXCHANGE=BYBIT
TRADING_ENV=DEMO
MARKET_MODE=DERIVATIVES
ORCHESTRATOR_ENV_FILE=

# =========================================================
# PACKAGE LOCATIONS / OWNED ENV FILES
# =========================================================
MARKET_INTEL_PACKAGE=crypto_market_intel
STRATEGY_PACKAGE=crypto_strategy_engine
RISK_EXECUTION_PACKAGE=crypto_risk_execution
MARKET_INTEL_PACKAGE_PATH=
STRATEGY_PACKAGE_PATH=
RISK_EXECUTION_PACKAGE_PATH=
MARKET_INTEL_ENV_FILE=
STRATEGY_ENV_FILE=
RISK_EXECUTION_ENV_FILE=

# =========================================================
# EXECUTION GUARDS
# =========================================================
ORCHESTRATOR_EXECUTION_ENABLED=false
ORCHESTRATOR_REAL_TRADING_ENABLED=false
DRY_RUN=true

# =========================================================
# SCANNER / WATCH RESOURCE ORCHESTRATION
# =========================================================
SCANNER_ORCHESTRATION_ENABLED=true
MAX_ACTIVE_SYMBOLS=60
MAX_DEEP_WATCH_SYMBOLS=30
MAX_SIMULTANEOUS_STRATEGY_EVALUATIONS=10
BREAKOUT_PROMOTION_ENABLED=true
PROMOTION_MIN_PRELIMINARY_SCORE=0.60
WATCH_PRIORITY_DECAY_SEC=60

# =========================================================
# EVENT LOOP / LATENCY
# =========================================================
MARKET_EVENT_QUEUE_MAX=1000
STRATEGY_EVENT_QUEUE_MAX=250
EXECUTION_EVENT_QUEUE_MAX=0
MARKET_SNAPSHOT_COALESCE=true
MAX_SNAPSHOT_TO_STRATEGY_MS=5000
MAX_STRATEGY_TO_RISK_MS=2000

# =========================================================
# HEALTH
# =========================================================
HEALTH_CHECK_INTERVAL_SEC=5
BLOCK_ON_MARKET_PACKAGE_UNHEALTHY=true
BLOCK_ON_STRATEGY_PACKAGE_UNHEALTHY=true
BLOCK_ON_RISK_PACKAGE_UNHEALTHY=true

# =========================================================
# RESTART / RECONCILIATION
# =========================================================
REQUIRE_RECONCILIATION_BEFORE_READY=true
RECOVER_ACTIVE_WATCHES=true
SHUTDOWN_SETTLE_TIMEOUT_SEC=30

# =========================================================
# WALK-FORWARD
# =========================================================
WALKFORWARD_ORCHESTRATION_ENABLED=true
WALKFORWARD_SCHEDULE=

# =========================================================
# STORAGE / LOGGING
# =========================================================
DATA_DIR=./data
ORCHESTRATOR_STATE_DB=./data/orchestrator_state.db
AUDIT_DIR=./data/audit
QUARANTINE_DIR=./data/quarantine
LOG_LEVEL=INFO

# Optional opt-in smoke switches. Both default off.
RUN_BYBIT_DEMO_E2E_SMOKE=false
ALLOW_BYBIT_DEMO_E2E_ORDER=false

