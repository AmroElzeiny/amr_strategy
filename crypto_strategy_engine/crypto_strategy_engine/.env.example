# =========================================================
# CONTRACT / MODE
# =========================================================
CONTRACT_VERSION=HM_CRYPTO_V1
EXCHANGE=BYBIT
TRADING_ENV=DEMO
MARKET_MODE=DERIVATIVES
STRATEGY_VERSION=HM_STRATEGY_V1
CONFIG_VERSION=HM_STRATEGY_CONFIG_V1

# =========================================================
# PATTERNS
# =========================================================
PRE_BREAKOUT_ENABLED=true
BREAKOUT_ENABLED=true
CONTINUATION_ENABLED=true
REVERSAL_ENABLED=true
PRIMARY_PATTERN=CONTINUATION
STRATEGY_TIMEFRAME_POLICY=AUTO_MULTI_TF

# =========================================================
# DECISION THRESHOLDS
# =========================================================
WATCH_MIN_CONFIDENCE=45
ARMED_MIN_CONFIDENCE=65
ENTER_MIN_CONFIDENCE=78
MIN_ACCEPTABLE_RR=0.80
PREFERRED_MIN_RR=1.00
TRADE_INTENT_TTL_MS=45000

# =========================================================
# CONTINUATION
# =========================================================
CONTINUATION_REQUIRE_REENGAGEMENT=true
CONTINUATION_PROJECTED_EXTENSION_MULT=1.60
CONTINUATION_FIB_LEVELS=0.50,0.618,0.786
CONTINUATION_FVG_LEVELS=0,0.25,0.50,0.75,1.00
CONTINUATION_MAX_MINOR_PULLBACK_ENTRIES=2
CONTINUATION_MIN_BREAKOUT_SCORE=62
CONTINUATION_MIN_PULLBACK_SCORE=55
CONTINUATION_MIN_LOCATION_SCORE=45
CONTINUATION_MIN_REENGAGEMENT_SCORE=55
CONTINUATION_MIN_TARGET_SCORE=45

# =========================================================
# PRE-BREAKOUT
# =========================================================
PRE_BREAKOUT_MIN_CONFIDENCE=84
PRE_BREAKOUT_MIN_LEVEL_STRENGTH=62
PRE_BREAKOUT_MIN_COMPRESSION_SCORE=62
PRE_BREAKOUT_MIN_DIRECTIONAL_PRESSURE=58

# =========================================================
# BREAKOUT
# =========================================================
BREAKOUT_MIN_CONFIDENCE=78
BREAKOUT_REQUIRE_ACCEPTANCE=true
BREAKOUT_REQUIRE_FOLLOWTHROUGH=true
BREAKOUT_IMMEDIATE_ENTRY_ENABLED=true
BREAKOUT_FIRST_PULLBACK_ENABLED=true
BREAKOUT_SECOND_PULLBACK_ENABLED=true
BREAKOUT_MAJOR_PULLBACK_REENTRY_ENABLED=true

# =========================================================
# REVERSAL
# =========================================================
REVERSAL_MIN_CONFIDENCE=80
REVERSAL_REQUIRE_LIQUIDITY_EVENT=true
REVERSAL_REQUIRE_OPPOSITE_DISPLACEMENT=true
REVERSAL_REQUIRE_MICRO_CONFIRMATION=true

# =========================================================
# BALANCE / FAKEOUT
# =========================================================
BALANCE_HARD_BLOCK_ENABLED=true
BALANCE_HARD_BLOCK_SCORE=76
CHOP_HARD_BLOCK_SCORE=75
FAILED_BREAKOUT_HARD_BLOCK_ENABLED=true
FAILED_BREAKOUT_HARD_BLOCK_SCORE=76
REVERSAL_RISK_BLOCK_SCORE=78

# =========================================================
# THESIS / REPEAT ATTEMPTS
# =========================================================
MAX_STRATEGY_ATTEMPTS_PER_THESIS=2
THESIS_COOLDOWN_SEC=900
THESIS_RESET_REQUIRE_MAJOR_EVENT=true

# =========================================================
# TARGETS
# =========================================================
TARGET_OBSTACLE_FILTER_ENABLED=true
LIQUIDITY_WALL_TARGET_FILTER_ENABLED=true
HTF_TARGET_FILTER_ENABLED=true
VOLUME_NODE_TARGET_FILTER_ENABLED=true

# =========================================================
# CONFIDENCE / COMPONENT WEIGHTS
# =========================================================
AI_MAX_POSITIVE_ADJUSTMENT=5
AI_MAX_NEGATIVE_ADJUSTMENT=20
CALIBRATION_ENABLED=true
CALIBRATION_MIN_SAMPLE=100
CALIBRATION_MAX_ADJUSTMENT=5
WEIGHT_STRUCTURE_QUALITY=0.12
WEIGHT_BREAKOUT_QUALITY=0.11
WEIGHT_LOCATION_QUALITY=0.09
WEIGHT_PULLBACK_QUALITY=0.10
WEIGHT_REENGAGEMENT_QUALITY=0.10
WEIGHT_ORDERFLOW_QUALITY=0.09
WEIGHT_VOLUME_QUALITY=0.07
WEIGHT_VALUE_QUALITY=0.07
WEIGHT_LIQUIDITY_QUALITY=0.06
WEIGHT_HTF_CONTEXT_QUALITY=0.06
WEIGHT_TARGET_QUALITY=0.07
WEIGHT_TIMING_QUALITY=0.04
WEIGHT_DATA_QUALITY_SCORE=0.02

# =========================================================
# STRATEGY PENALTIES
# =========================================================
PENALTY_BALANCE_RISK=24
PENALTY_CHOP_RISK=20
PENALTY_FAILED_BREAKOUT_RISK=26
PENALTY_REVERSAL_RISK=24
PENALTY_LATE_ENTRY=10
PENALTY_OVEREXTENDED_ENTRY=12
PENALTY_WEAK_BREAKOUT=12
PENALTY_WEAK_RETEST=10
PENALTY_COUNTERTREND_PULLBACK=20
PENALTY_ORDERFLOW_CONTRADICTION=14
PENALTY_VALUE_NOT_MIGRATING=12
PENALTY_POC_STAGNATION=12
PENALTY_HTF_COUNTER_STRUCTURE=12
PENALTY_TARGET_OBSTRUCTION=16
PENALTY_INSUFFICIENT_RR=20
PENALTY_LIQUIDITY_WALL=14
PENALTY_STALE_SIGNAL=25
PENALTY_DEGRADED_DATA=12
PENALTY_MISSING_CRITICAL_EVIDENCE=18
PENALTY_THESIS_REPEAT=8
PENALTY_ATTEMPT_EXHAUSTION=100
PENALTY_DIRECTIONAL_EXHAUSTION=14
PENALTY_LOW_FOLLOW_THROUGH=14

# =========================================================
# AI
# =========================================================
AI_ENABLED=true
AI_REQUIRED_FOR_ENTER=true
AI_PROVIDER_SELECT=opencode
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go
OPENCODE_QWEN_MODEL=qwen3.8-flash
OPENCODE_MUSE_MODEL=muse-spark-1.3-contributor
# Reserved documentary fields: current implementation uses each provider's official
# protocol and does not send unsupported reasoning parameters to OpenCode Go.
OPENCODE_QWEN_REASONING_EFFORT=
OPENCODE_MUSE_REASONING_EFFORT=
OPENCODE_ROUTING_ENABLED=true
OPENCODE_DUAL_REVIEW_ENABLED=true
AI_ANALYST_MODEL=muse-spark-1.3-contributor
AI_CRITIC_MODEL=qwen3.8-flash
AI_ADJUDICATOR_MODEL=qwen3.8-flash
AI_ADJUDICATOR_ENABLED=true
AI_CALL_MIN_DETERMINISTIC_CONFIDENCE=45
AI_TOTAL_DEADLINE_MS=6000
AI_PROVIDER_TIMEOUT_MS=2500
AI_MAX_RETRIES=1
AI_LATE_RESPONSE_POLICY=IGNORE

# =========================================================
# OPENAI FALLBACK
# =========================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_FALLBACK_ENABLED=true
OPENAI_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_SERVICE_TIER=flex
OPENAI_TIMEOUT_SEC=4
OPENAI_MAX_OUTPUT_TOKENS=1500

# =========================================================
# WALK-FORWARD
# =========================================================
WALKFORWARD_ENABLED=true
WALKFORWARD_TRAIN_DAYS=30
WALKFORWARD_VALIDATION_DAYS=7
WALKFORWARD_TEST_DAYS=7
WALKFORWARD_STEP_DAYS=7
WALKFORWARD_MIN_TRADES=20
WALKFORWARD_MAX_DRAWDOWN_R=12
WALKFORWARD_MAX_SUBGROUP_REGRESSION_R=0.75
WALKFORWARD_MIN_WINDOW_EXPECTANCY_R=-0.25
WALKFORWARD_AUTO_PROMOTE=false
WALKFORWARD_AI_RESEARCH_ENABLED=true
WALKFORWARD_ABLATION_ENABLED=true
WALKFORWARD_CALIBRATION_ENABLED=true

# =========================================================
# MEMORY
# =========================================================
TRADE_MEMORY_ENABLED=true
TRADE_MEMORY_DB=./data/trade_memory.db
HISTORICAL_ANALOGUE_ENABLED=true
HISTORICAL_ANALOGUE_MIN_SAMPLE=20
HISTORICAL_ANALOGUE_MAX_RESULTS=12

# =========================================================
# STORAGE
# =========================================================
DATA_DIR=./data
DECISION_LOG_DIR=./data/decisions
RESEARCH_DIR=./data/research
QUARANTINE_DIR=./data/quarantine

# =========================================================
# QUALITY / OBSERVABILITY
# =========================================================
LOG_LEVEL=INFO
STRATEGY_DETERMINISTIC_LATENCY_BUDGET_MS=50
FAIL_ON_INVALID_CONTRACT=true
FAIL_ON_INVALID_DATA=true
FAIL_ON_STALE_CRITICAL_DATA=true
DEGRADED_ENTER_ALLOWED=false
MAX_SNAPSHOT_AGE_MS=15000
MAX_SOURCE_AGE_MS=20000
