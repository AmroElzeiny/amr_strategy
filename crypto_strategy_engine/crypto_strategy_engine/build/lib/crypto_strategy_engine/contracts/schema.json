{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hm-crypto-v1",
  "title": "HM_CRYPTO_V1 Frozen Inter-Package Contract",
  "type": "object",
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "exchange": {"enum": ["BYBIT", "BINANCE"]},
    "environment": {"enum": ["DEMO", "REAL"]},
    "marketMode": {"enum": ["SPOT", "DERIVATIVES"]},
    "patternType": {"enum": ["PRE_BREAKOUT", "BREAKOUT", "CONTINUATION", "REVERSAL"]},
    "direction": {"enum": ["LONG", "SHORT", "NONE"]},
    "orderIntent": {"enum": ["OPEN", "CLOSE", "REDUCE", "NONE"]},
    "decisionState": {"enum": ["NO_TRADE", "WATCH", "ARMED", "ENTER"]},
    "regimeType": {"enum": ["TREND_EXPANSION", "HEALTHY_PULLBACK", "BALANCE", "FAILED_BREAKOUT", "REVERSAL_RISK", "RANGE", "UNKNOWN"]},
    "dataQuality": {"enum": ["GOOD", "DEGRADED", "STALE", "INVALID"]},
    "marketSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "contract_version", "snapshot_id", "created_at_utc", "event_time_utc",
        "exchange", "environment", "market_mode", "symbol", "instrument", "ticker",
        "timeframes", "structure", "levels", "volume_profile", "orderflow", "orderbook",
        "derivatives", "regime", "breakout_alert", "data_quality", "quality_reasons",
        "feature_versions", "source_timestamps"
      ],
      "properties": {
        "contract_version": {"const": "HM_CRYPTO_V1"},
        "snapshot_id": {"type": "string", "minLength": 8},
        "created_at_utc": {"$ref": "#/$defs/utcTimestamp"},
        "event_time_utc": {"$ref": "#/$defs/utcTimestamp"},
        "exchange": {"$ref": "#/$defs/exchange"},
        "environment": {"$ref": "#/$defs/environment"},
        "market_mode": {"$ref": "#/$defs/marketMode"},
        "symbol": {"type": "string", "minLength": 2},
        "instrument": {"type": "object"},
        "ticker": {"type": "object"},
        "timeframes": {"type": "object", "minProperties": 1},
        "structure": {"type": "object"},
        "levels": {"oneOf": [{"type": "object"}, {"type": "array", "items": {"type": "object"}}]},
        "volume_profile": {"type": "object"},
        "orderflow": {"type": "object"},
        "orderbook": {"type": "object"},
        "derivatives": {"type": ["object", "null"]},
        "regime": {"type": "object", "required": ["type"], "properties": {"type": {"$ref": "#/$defs/regimeType"}}},
        "breakout_alert": {"type": ["object", "null"]},
        "data_quality": {"$ref": "#/$defs/dataQuality"},
        "quality_reasons": {"type": "array", "items": {"type": "string"}},
        "feature_versions": {"type": "object"},
        "source_timestamps": {"type": "object"}
      }
    },
    "tradeIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "signal_id", "snapshot_id", "created_at_utc", "exchange",
        "environment", "market_mode", "symbol", "pattern_type", "direction", "order_intent",
        "decision", "thesis_id", "attempt_no", "deterministic_confidence", "ai_confidence",
        "final_confidence", "entry_plan", "invalidation", "targets", "projected_extension_target",
        "risk_reward", "penalties", "blockers", "evidence", "ttl_ms", "config_version",
        "strategy_version", "ai_metadata", "integrity_hash"
      ],
      "properties": {
        "contract_version": {"const": "HM_CRYPTO_V1"},
        "signal_id": {"type": "string"},
        "snapshot_id": {"type": "string"},
        "created_at_utc": {"$ref": "#/$defs/utcTimestamp"},
        "exchange": {"$ref": "#/$defs/exchange"},
        "environment": {"$ref": "#/$defs/environment"},
        "market_mode": {"$ref": "#/$defs/marketMode"},
        "symbol": {"type": "string"},
        "pattern_type": {"$ref": "#/$defs/patternType"},
        "direction": {"$ref": "#/$defs/direction"},
        "order_intent": {"$ref": "#/$defs/orderIntent"},
        "decision": {"$ref": "#/$defs/decisionState"},
        "thesis_id": {"type": "string"},
        "attempt_no": {"type": "integer", "minimum": 0},
        "deterministic_confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "ai_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "final_confidence": {"type": "number", "minimum": 0, "maximum": 100},
        "entry_plan": {"type": "object"},
        "invalidation": {"type": "object"},
        "targets": {"type": "array", "items": {"type": "object"}},
        "projected_extension_target": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "risk_reward": {"type": ["number", "null"]},
        "penalties": {"type": "array", "items": {"type": "object"}},
        "blockers": {"type": "array", "items": {"type": "object"}},
        "evidence": {"type": "object"},
        "ttl_ms": {"type": "integer", "minimum": 1},
        "config_version": {"type": "string"},
        "strategy_version": {"type": "string"},
        "ai_metadata": {"type": "object"},
        "integrity_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "executionReport": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "contract_version", "execution_id", "signal_id", "created_at_utc", "exchange",
        "environment", "market_mode", "symbol", "approved", "reason_codes", "final_qty",
        "final_notional", "leverage", "margin_mode", "order_ids", "order_link_ids", "order_state",
        "fill_state", "avg_fill_price", "fees", "realized_pnl", "stop_state", "take_profit_state",
        "risk_snapshot_before", "risk_snapshot_after", "daily_loss_lock", "max_loss_lock", "reconciled",
        "integrity_hash"
      ],
      "properties": {
        "contract_version": {"const": "HM_CRYPTO_V1"},
        "execution_id": {"type": "string"},
        "signal_id": {"type": "string"},
        "created_at_utc": {"$ref": "#/$defs/utcTimestamp"},
        "exchange": {"$ref": "#/$defs/exchange"},
        "environment": {"$ref": "#/$defs/environment"},
        "market_mode": {"$ref": "#/$defs/marketMode"},
        "symbol": {"type": "string"},
        "approved": {"type": "boolean"},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "final_qty": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "final_notional": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "leverage": {"type": ["number", "null"]},
        "margin_mode": {"type": ["string", "null"]},
        "order_ids": {"type": "array"},
        "order_link_ids": {"type": "array"},
        "order_state": {"type": "string"},
        "fill_state": {"type": "string"},
        "avg_fill_price": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "fees": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "realized_pnl": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "stop_state": {"type": "string"},
        "take_profit_state": {"type": "string"},
        "risk_snapshot_before": {"type": "object"},
        "risk_snapshot_after": {"type": "object"},
        "daily_loss_lock": {"type": "boolean"},
        "max_loss_lock": {"type": "boolean"},
        "reconciled": {"type": "boolean"},
        "integrity_hash": {"type": "string"}
      }
    }
  },
  "properties": {
    "MarketSnapshot": {"$ref": "#/$defs/marketSnapshot"},
    "TradeIntent": {"$ref": "#/$defs/tradeIntent"},
    "ExecutionReport": {"$ref": "#/$defs/executionReport"}
  }
}
