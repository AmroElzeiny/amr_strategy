{
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "^(apply_patch|Write|Edit)$",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \".codex\\\\hooks\\\\amr-delegation-gate.ps1\""
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "^(Bash|shell|shell_command|exec_command|powershell)$",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \".codex\\\\hooks\\\\amr-shell-gate.ps1\""
                                                       }
                                                   ]
                                     }
                                 ]
              }
}